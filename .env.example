# ---- Trader Guider .env (copy to .env and fill in) ----
PORT=3000
# Bind address: 0.0.0.0 for cloud hosts (Render etc.), 127.0.0.1 for localhost-only
HOST=0.0.0.0

# JWT session secret — generate a long random string, keep private
JWT_SECRET=change-me-to-a-long-random-string

# 32-byte hex key used to AES-encrypt stored exchange API keys.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars

# ---- Database ----
# Leave empty for localhost SQLite (zero config, file at ./data/trader-guider.db).
# Set to a Postgres connection string for cloud mode (e.g. Supabase free tier):
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# ---- Execution safety (defaults = everything is fake/safe) ----
# DRY_RUN=true  -> orders are only LOGGED, never sent anywhere (default)
# Set to false only when you consciously want real order flow to testnet/demo.
DRY_RUN=true

# URL of the local MT5 bridge (runs on your Windows PC, see mt5-bridge/).
# In cloud mode the server usually can't reach it — the panel then shows
# "bridge not connected". Only set this if you expose your bridge publicly.
MT5_BRIDGE_URL=http://127.0.0.1:5001

# Binance TESTNET base URLs (free test keys from testnet.binance.vision)
BINANCE_SPOT_TESTNET=https://testnet.binance.vision
BINANCE_FUTURES_TESTNET=https://testnet.binancefuture.com

# BINANCE_LIVE_ENABLED=false -> mainnet orders are REJECTED server-side
# (testnet venues always work). Set to "true" only when you consciously
# want REAL-money Binance orders. DRY_RUN=false is also required.
BINANCE_LIVE_ENABLED=false

# Cookie lifetime in days (persistent login)
SESSION_DAYS=30
# Set to "true" behind HTTPS (cloud) so the session cookie is Secure.
# Requires the app to trust the host's proxy (already enabled in server.js).
COOKIE_SECURE=false

# ---- Firebase (optional; hardcoded defaults in lib/firebase-auth-adapter.js) ----
# Only FIREBASE_APP_ID is required to activate Firebase auth; the rest fall
# back to the compiled-in trader-guider project values.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_SENDER_ID=
# FIREBASE_APP_ID=
