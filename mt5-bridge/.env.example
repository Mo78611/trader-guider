# MT5 Bridge .env (copy to .env)
# Everything defaults to SAFE. Read app.py header before changing.

# Orders are only LOGGED, never sent. Keep true until you are ready.
DRY_RUN=true

# Master arm switch for real order flow. Needs DRY_RUN=false too.
LIVE_TRADING=false

# Even with live trading armed, REAL-money accounts are blocked unless true.
ALLOW_REAL_ACCOUNT=false

# Local port the bridge listens on (Node backend calls this URL)
MT5_BRIDGE_PORT=5001
